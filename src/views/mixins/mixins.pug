mixin ProgramCard(img='assets/imgs/page/portfolio/portfolio-1.png', cat='Branding', name='Brand Identity for Global JSC', subtitle='August 25, 2025', cardHref="page-portfolio-single.html")
    .col-lg-6.col-md-6.col-sm-6.col-12.mb-24
        .card
            .row.g-0
                .col-sm-5(style='background-image: url(' + img + '); background-size: cover; background-position: center; min-height: 250px;')
                .col-sm-7.position-relative
                    .card-body.h-100.d-flex.flex-column.justify-content-between
                        .p-2
                            span.text-body-small.color-gray-500.font-bold= cat
                            h5.card-title.mt-10= name
                            p.card-text.mt-10= subtitle
                            if block
                                block
                        .p-2
                            a.btn.btn-sm.btn-black(href=cardHref) Learn More
                            a.hover-up.ml-10.btn.btn-sm.btn-brand(href="/apply/") Apply Now

mixin ProgramSection(img='assets/imgs/page/portfolio/portfolio-1.png', cat='Branding', name='Brand Identity for Global JSC', subtitle='August 25, 2025', cardHref="page-portfolio-single.html", containerExtraClass='bg-orange-100')
  section.program-section
    .container.box-program(class=containerExtraClass)
      .row
        .col-lg-5.col-md-7.mb-30
          if containerExtraClass === 'bg-2'
            .tag-1.bg-brand-light-blue.color-white= cat
          else
            .tag-1.bg-gray-100.color-gray-900= cat
          h3.text-heading-1.mt-30= name
          p.text-body-lead-large.color-gray-600.mt-30= subtitle
          if block
            .mt-30
                block
          .mt-40.actions
            a.btn.btn-default.btn-white.icon-arrow-right.text-body-text(href=cardHref) Learn More
            a.btn.btn-default.btn-brand.icon-arrow-right.text-body-text(href="/apply/") Apply
        .col-lg-7.col-md-5.position-relative
            img.img-responsive.img-program(src=img, alt=name)
           
         
//-
  Secondary nav tabs — a horizontal row of pill links used to switch between
  sibling pages (e.g. Programs, Structures, Majors, Minors). Pass the current
  page's href as `activeHref` so the matching link is highlighted.
  links: [{ href: '/majors/', text: 'Majors' }, ...]
mixin SecondaryNavTabs(links, activeHref)
  section.section-box.secondary-nav-tabs.bg-gray-100.pt-20.pb-20
    .container
      .text-center
        ul.nav.justify-content-center(role='tablist')
          each link in links
            li
              a.nav-tab-link(href=link.href, class=link.href === activeHref ? 'active' : '')= link.text

mixin BreadcrumbSection(title, subtitle, buttonData = [{ href: '/programs/', text: 'Explore Programs', class: 'btn-square' }])
  section.section-box
    .banner-hero.banner-breadcrums
      .container
        .row
          .col-lg-7
            h1.text-heading-4.color-gray-900.mb-20= title
            p.text-body-text.color-gray-500= subtitle
            if buttonData
                .col-lg-7.d-flex.justify-content-between.align-items-center.mt-40
                    each button in buttonData
                        a.text-heading-6.btn(class=button.class, href=button.href)= button.text