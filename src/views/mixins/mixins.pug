mixin CategoryCard(CatImg='assets/imgs/page/shop1/pc.svg', CatTitle='Desktop PC', TotalProducts='4553 products')
    .col-xl-2.col-lg-3.col-md-4.col-sm-6.col-12
        .category-grid-3.hover-up
          .category-img
            a(href='#')
              img(src= CatImg alt='agon')
          h4.text-heading-5.mb-5=CatTitle
          p.text-body-text.color-gray-500=TotalProducts

mixin ProductCard-2(ProdImg='assets/imgs/page/homepage5/sp1.png', ProdTitle='Bass ultra x-203. Head phone', ProdPrice='$29.8', ProdOldPrice='32.85')
    .col-xl-4.col-lg-6.col-md-12.col-sm-12
        .product-item-1.hover-up
          a(href='#')
            .product-image
              img(src= ProdImg alt='agon')
            .product-info
              h3.title-product= ProdTitle
              span.price-regular.mr-15= ProdPrice
              span.price-regular.price-line= ProdOldPrice

mixin PortfolioCard-1(img='assets/imgs/page/portfolio/portfolio-1.png', cat='Branding', name='Brand Identity for Global JSC', date='August 25, 2025', dataCategory="branding")
    .col-xl-3.col-lg-6.col-md-6.col-sm-6.col-12
        .product-item-2.portfolio-card.hover-up(data-category= dataCategory)
            .item-content
                a(href='page-portfolio-single.html')
                    .product-image
                        img(src= img alt='agon')                    
                        a.text-body-small.color-gray-500.font-bold.cat(href='page-portfolio-grid-1.html')= cat       
                        a.view-details(href='page-portfolio-single.html')
                .product-info
                    span.color-gray-500=date
                    a(href='page-portfolio-single.html')
                        h3.text-body-lead.color-gray-900= name

mixin PortfolioCard-2(img='assets/imgs/page/portfolio/portfolio-1.png', name='Brand Identity for Global JSC', link='page-portfolio-single.html', date='August 25, 2025')
    .col-xl-4.col-lg-6.col-md-6.col-sm-6.col-12
        .product-item-2.portfolio-card.hover-up
            .item-content
                a(href=link)
                    .product-image
                        img(src= img alt='agon')                    
                        a.view-details(href=link)
                .product-info
                    span.color-gray-500=date
                    a(href=link)
                        h3.text-body-lead.color-gray-900= name

mixin ProgramCard(img='assets/imgs/page/portfolio/portfolio-1.png', cat='Branding', name='Brand Identity for Global JSC', subtitle='August 25, 2025', cardHref="page-portfolio-single.html")
    .col-lg-6.col-md-6.col-sm-6.col-12.mb-24
        .card
            .row.g-0
                .col-sm-5(style='background-image: url(' + img + '); background-size: cover; background-position: center; min-height: 250px;')
                .col-sm-7.position-relative
                    .card-body.h-100.d-flex.flex-column.justify-content-between
                        .p-2
                            span.text-body-small.color-gray-500.font-bold= cat
                            h5.card-title.mt-10= name
                            p.card-text.mt-10= subtitle
                        .p-2
                            a.btn.btn-sm.btn-black(href=cardHref) Learn More
                            a.hover-up.ml-10.btn.btn-sm.btn-brand(href="/apply/") Apply Now

mixin CourseTableRow(courseCode, courseDescription, courseHours)
    tr
        td= courseCode
        td= courseDescription
        td= courseHours

mixin PeopleCard(img='assets/imgs/page/about/1/team-1.png', name='Theresa Webb', title='Marketing CEO', description='Lorem ipsum dolor sit amet consectetur imp adipiscing elit justo', socialLinks=['#', '#', '#', '#'])
    .col-lg-3.col-md-6.col-sm-6
        .card-grid-style-5.hover-up
        if img
            .grid-5-img.mb-15
                img(src= img alt= name)
        span.text-body-text-md.color-gray-500= title
        h3.text-heading-5.mb-5.mt-5= name
        p.text-body-excerpt.text-desc.color-gray-500.mt-15.mb-20= description

mixin ContentLeftImageRight(img)
    .row
        .col-lg-6
            if block
                block
        .col-lg-6.d-flex.justify-content-center.flex-column
            img.img-responsive.bdr-10.mt-10.ml-10(src= img, alt='Agon')

mixin NewsCard(title, image, link, date='01/01/2026')
    .col-lg-4.col-sm-12.pr-30
        .card-grid-style-4
            a.text-heading-4(href=link)= title
            .grid-4-img
                span.tag-dot= date
                a(href=link)
                    img(src=image, alt=title)
                 
mixin HomeSectionNavGridItem(title, image, position='')
    .grid-nav-container(class=position)
        .grid-nav-background
            img(src= image alt=title)                    
        .grid-nav-content
            .heading= title
            if block
                block

mixin HomeSectionNavGridItem-2(title, image, position='')
    .grid-nav-container(class=position)
        .grid-nav-background
            img(src=image, alt=title)                    
        .grid-nav-content.no-background
            .heading= title