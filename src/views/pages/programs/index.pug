extends ../../layouts/master.pug

block title
  title Programs Overview - Nazarene Bible College
  meta(name='description', content='Explore Nazarene Bible College’s programs, including degree and certificate programs, and non-degree course of study.')

block header
  include ../../components/header.pug

block content
  section.section-box
    .banner-hero.nav-breadcrums.bg-gray-100
      .container
        .breadcrumb
          ul
            li.home
              a(href='/') Home
            li
              span Programs
  include ../../sections/portfolio_page_title.pug

  +ProgramSection('/assets/imgs/page/programs/200479219-001.jpg', 'Degree', 'Bachelors of Arts in Ministry', 'Four Year College Degree', '/programs/bachelor-of-arts-in-ministry/', 'bg-2')
    .content-detail
      ul 
        li Designed to help students grow in ministry skills and Bible knowledge. 
        li Prepares students for leadership roles as pastors, counselors, educators, mission workers and in other frontline ministry roles. 
        li Equips students to lead and support the work of the Church as deacons, music ministers, administrators and team leaders.

  +ProgramSection('/assets/imgs/page/programs/89142972.jpg', 'Degree', 'Assosiate of Arts in Ministry', 'Two Year College Degree','/programs/associate-of-arts-in-ministry/', 'bg-5')
    .content-detail
      ul 
        li Designed for students who want to gain ministry skills and knowledge in order to serve as lay workers in churches or Christian organizations.
        li Concentrations offered: Christian Educational Ministries, Church Ministries, Early Education, and Hispanic Pastoral Ministries.

  +ProgramSection('/assets/imgs/page/programs/92825321.jpg', 'Certificate Program', 'Ministry Preparation Program', 'Fulfilling Education Requirements for Ordination Solely in the Church of the Nazarene', '/programs/ministry-preparation-program/', 'bg-6')
    .content-detail
      ul 
        li Offers a series of 1-hour credit courses to prepare students for ordination. 
        li Provides training for ministry. 
        li Ordination is accomplished through a student's denomination. 
        li Students who want to receive additional credit should consider a ministry degree program.
    p.text-body-small.color-gray-500.mt-20.mb-20 NBC is approved by the Church of the Nazarene International Board of Education for training leaders toward ordination or commission in the ministries of the Church of the Nazarene. This certificate program is designed to fulfill the education requirements for ordination solely in the Church of the Nazarene and may also be helpful for ordination in other denominations.
     
  +ProgramSection('/assets/imgs/page/programs/87462551.jpg', 'Non-college Credit', 'Ministerial Training', 'Non-degree Course of Study','/programs/non-degree-course-of-study/', 'bg-10')
    .content-detail
      ul 
        li Video-based ministerial training curriculum designed specifically for the USA/Canada Region of the Church of the Nazarene. 
        li Provides accessible, high-quality education for those pursuing ordination in ministry.
        li Helpful for pastors and ministry leaders in other denominations.
      p.text-body-small.color-gray-500.mt-20.mb-20 Note: These are continuing education classes, not for college credit, and will not appear on an official college transcript. NBC's registrar does keep records of student participation and classes completed.
