extends ../layouts/master.pug

block title
  title Nazarene Bible College - Home

block header
  include ../components/header.pug

block content
  include ../sections/section_hero_4.pug
  include ../sections/latest_news.pug
  include ../sections/home_section_nav_grid.pug

  section.section-box.mtb-60
    .container
      +ContentLeftImageRight('/assets/imgs/stock/NBC working web 7.png', 'mb-100')
        .d-flex.flex-column.p-40
          p.text-body-lead-large.text-gray-600.mb-20
            | Accredited. Affordable. Accessible.
          h2.text-heading-2.color-gray-900.mb-40
            | Preparing leaders for service in the Church and the world.
          .d-flex
            a.btn.btn-brand(href='/about/') About NBC
            a.ml-20.btn.btn-default.hover-up.icon-arrow-right(href='/give/') Give

      +ContentRightImageLeft('/assets/imgs/stock/AdobeStock_286503364.jpeg', 'bg-gray-100 p-20 rounded-4')
        .d-flex.flex-column.p-40
          .text-heading-2.color-gray-900.mb-20
            | Turn Your Calling Into a Reality
          p.text-body-text.text-gray-600.mb-40
            | If you feel God's calling on your life to become a Christian leader or minister of the Gospel, Nazarene Bible College's 100% online training programs can help you reach your goals.
          p.text-body-text.text-gray-600.mb-40
            | We are an accredited Institution that provides academic and practical programs. We provide clear guidelines and plenty of support to all of our students.
          .d-flex
            a.btn.btn-brand(href='/programs/') Explore Programs
