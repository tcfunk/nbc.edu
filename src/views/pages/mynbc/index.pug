extends ../../layouts/master.pug

block title
  title NBC - MyNBC
  meta(name='description', content='MyNBC is a portal for students to manage their academic records, schedule, and other important information.')

block header
  include ../../components/header.pug

block content
  .section-box
    .banner-hero.banner-homepage6
      .container
        .row
          .col-lg-7.mt-50.pb-120
            h1.text-display-2.mt-20 My NBC
            p.text-body-lead-large.color-gray-500.mt-30.pr-40
              | Welcome to the Student Dashboard.
            .mt-40
              a.btn.btn-black.shape-square.icon-arrow-right-white(href='#') Class Content
              a.btn.btn-link.icon-triangle.color-gray-900.ml-40(href='#') Class Discussion
              a.btn.btn-link.icon-triangle.color-gray-900.ml-40(href='#') Student Portal
          .col-lg-5.d-none.d-lg-block
            .banner-imgs
              img.img-banner.img-responsive.rounded-4(alt='Agon', src='/assets/imgs/stock/AdobeStock_968974436_vertical.jpeg')
  .section-box.box-slider-3.d-none.d-lg-flex
    .container
      .row.up-50.z-3
        .col-3
          .grid-category.grid-category-style-2
            a(href='https://email.nbc.edu/').grid-image-left-category
              .category-image
                i.fi-rr-envelope.icon-md
              .category-info
                h3.text-heading-6 Webmail
            .grid-image-bottom
              a(href='https://email.nbc.edu/')
                img(src='/assets/imgs/page/homepage6/img-2.png')
        .col-3
          .grid-category.grid-category-style-2
            a(href='/library/').grid-image-left-category
              .category-image
                i.fi-rr-building.icon-md
              .category-info
                h3.text-heading-6 Library
            .grid-image-bottom
              a(href='/library/')
                img(src='/assets/imgs/page/homepage6/img-3.png')
        .col-3
          .grid-category.grid-category-style-2
            a(href='/bookstore/').grid-image-left-category
              .category-image
                i.fi-rr-book.icon-md
              .category-info
                h3.text-heading-6.mt-15 Bookstore
            .grid-image-bottom
              a(href='/bookstore/')
                img(src='/assets/imgs/page/homepage6/img-3.png')
        .col-3
          .grid-category.grid-category-style-2
            a(href='/handbook/').grid-image-left-category
              .category-image
                i.fi-rr-book-alt.icon-md
              .category-info
                h3.text-heading-6.mt-15 Handbook
            .grid-image-bottom
              a(href='/handbook/')
                img(src='/assets/imgs/page/homepage6/img-3.png')

  section.section-box
    .container.mt-100
      .row
        .col-lg-6.mb-50
          h2.text-heading-2.color-gray-900.mb-10 Login
          p.text-body-lead.color-gray-600.mb-30 Sign in to your NBC systems
          .row
            .col-sm-6.col-12
              a.quick-link-item(href='https://online.nbc.edu/')
                .quick-link-icon
                  i.fi-rr-laptop
                h3.text-heading-6 dCourseWeb
            .col-sm-6.col-12
              a.quick-link-item(href='https://scribe.nbc.edu/')
                .quick-link-icon
                  i.fi-rr-edit-alt
                h3.text-heading-6 Scribe
            .col-sm-6.col-12
              a.quick-link-item(href='https://portal.nbc.edu/')
                .quick-link-icon
                  i.fi-rr-sign-in-alt
                h3.text-heading-6 Portal
        .col-lg-6.mb-50
          h2.text-heading-2.color-gray-900.mb-10 Quick Links
          p.text-body-lead.color-gray-600.mb-30 Resources and services for NBC students
          .row
            .col-sm-6.col-12
              a.quick-link-item(href='/catalog/')
                .quick-link-icon
                  i.fi-rr-book
                h3.text-heading-6 College Catalog
            .col-sm-6.col-12
              a.quick-link-item(href='/schedule/online-courses/')
                .quick-link-icon
                  i.fi-rr-list-check
                h3.text-heading-6 Online Course List
            .col-sm-6.col-12
              a.quick-link-item(href='https://portal.nbc.edu/')
                .quick-link-icon
                  i.fi-rr-credit-card
                h3.text-heading-6 Pay Account
            .col-sm-6.col-12
              a.quick-link-item(href='https://nbc.edu/success/')
                .quick-link-icon
                  i.fi-rr-graduation-cap
                h3.text-heading-6 Student Success
            .col-sm-6.col-12
              a.quick-link-item(href='/schedule/')
                .quick-link-icon
                  i.fi-rr-calendar
                h3.text-heading-6 Academic Calendar
            .col-sm-6.col-12
              a.quick-link-item(href='https://nbc.edu/offices/')
                .quick-link-icon
                  i.fi-rr-address-book
                h3.text-heading-6 Contacts
            .col-sm-6.col-12
              a.quick-link-item(href='https://nbc.edu/forms/individual-request-transcript/')
                .quick-link-icon
                  i.fi-rr-document-signed
                h3.text-heading-6 Request Your NBC Transcript
            .col-sm-6.col-12
              a.quick-link-item(href='https://nbc.edu/consumer-information/')
                .quick-link-icon
                  i.fi-rr-shield-check
                h3.text-heading-6 Consumer Information

  section.section-box
    .container.mt-100
      .row
        .col-lg-1.col-sm-1.col-12
        .col-lg-10.col-sm-10.col-12.text-center
          h2.text-heading-1.color-gray-900.mb-10 Latest News
          p.text-body-lead-large.color-gray-600.mt-20 The 6 most recent stories from NBC News
        .col-lg-1.col-sm-1.col-12
    .container.mt-90
      .filter-gallery
        .row
          each item in nbcData.news.sort((a, b) => new Date(b.date) - new Date(a.date)).slice(0, 6)
            +PortfolioCard-2('/assets/imgs/page/blog/2/img-news-1.png', item.title, '/news/sample-article/', new Date(item.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }))
      .mt-20.mb-30.text-center
        a.btn.btn-black.icon-arrow-right-white(href='/news/') View More News


