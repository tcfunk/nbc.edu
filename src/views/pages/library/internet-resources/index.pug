extends ../../../layouts/master.pug

block title
  title Online Ministry &amp; Bible Study Resources | Nazarene Bible College Library
  meta(name='description', content='Explore curated online resources for biblical studies, ministry training, preaching, counseling and Christian leadership. Organized by Nazarene Bible College’s library to support adult learners.')

block header
  include ../../../components/header.pug

block content
  section.section-box
    .banner-hero.nav-breadcrums.bg-gray-100
      .container
        .breadcrumb
          ul
            li.home
              a(href='/') Home
            li
              a(href='/library/') Library
            li
              span Internet Resources

  section.section-box
    .banner-hero.banner-head-image(style='background: url(/assets/imgs/stock/AdobeStock_356337517.jpeg); background-size: cover; background-position: center center;')
      .container
        .text-center
          h1.text-heading-1.color-white.mt-30
            | Online Ministry &amp; Bible Study Resources

  section.section-box.mt-50.mb-50
    .container
      .row
        .col-lg-2
        .col-lg-8.text-center
          p.text-body-lead-large.color-gray-600
            | The Nazarene Bible College Library provides carefully selected online resources to support students preparing for ministry, biblical studies, counseling and Christian leadership. These tools offer flexible study options, scholarly references and practical ministry-development content to strengthen your academic work and ministry preparation.
        .col-lg-2

