extends ../../layouts/master.pug

block title
  title Academic Structures &amp; Program Pathways | Nazarene Bible College
  meta(name='description', content='Explore Nazarene Bible College’s degree programs, accelerated options, ordination preparation, and continuing education pathways.')

block header
  include ../../components/header.pug

block content

  section.section-box
    .banner-hero.nav-breadcrums.bg-gray-100
      .container
        .breadcrumb
          ul
            li.home
              a(href='/') Home
            li
              span Academic Structures &amp; Program Pathways

  section.section-box
    .banner-hero.banner-head-image(style='background: url(/assets/imgs/stock/AdobeStock_560002892.jpeg); background-size: cover; background-position: center center;')
      .container
        .text-center
          h1.text-heading-1.color-white.mt-30
            | Academic Structures &amp; Program Pathways

  +SecondaryNavTabs([
    { href: '/delivery/', text: 'Course Delivery' },
    { href: '/programs/', text: 'Programs' },
    { href: '/structures/', text: 'Structures' },
    { href: '/majors/', text: 'Majors' },
    { href: '/minors/', text: 'Minors' },
    { href: '/concentrations/', text: 'Concentrations' },
    { href: '/tracks/', text: 'Tracks' }
  ], '/structures/')

  include ../../sections/structures_tab_section.pug