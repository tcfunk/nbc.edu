extends ../../layouts/master.pug

block title
  title Nazarene Bible College News | Ministry Stories, Updates & Announcements
  meta(name='description', content='Stay informed with the latest news from Nazarene Bible College. Read ministry stories, campus updates, student and faculty features, and announcements for future and current ministry leaders.')

block header
  include ../../components/header.pug

block content
  section.section-box
    .banner-hero.banner-breadcrums.bg-gray-100
      .container.text-center
        .row
          .col-lg-12
            h1.text-display-3.color-gray-900.mb-20 Nazarene Bible College News & Ministry Updates
  section.section-box
    .container.mt-130
      p.text-body-lead.color-gray-600.mb-20
        | Nazarene Bible College is committed to preparing adults for ministry, and our news updates highlight the stories, people, and events shaping our community. Explore student testimonies, faculty insights, ministry reflections, and important announcements that support your journey toward answering God’s call.
    .container.mt-90
      .row
        // loop through the news items and display them in a card-grid-style-4
        .col-lg-8.col-sm-12.pr-30.mb-50
          each item in nbcData.news.sort((a, b) => new Date(b.date) - new Date(a.date))
            .card-grid-style-4
              .grid-4-img.mb-20
                a(href='/news/sample-article/')
              a.text-heading-4(href='/news/sample-article/')= item.title
              p.text-body-text.color-gray-500= item.excerpt
              p.text-body-small.color-gray-500.mt-20= new Date(item.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
          .paginations.mt-100
            ul.pager
              li
                a.prev-page(href='#')
              li
                a(href='#') 1
              li
                a(href='#') 2
              li
                a(href='#') 3
              li
                a.page-dotted(href='#')
              li
                a.next-page(href='#')

        // news sidebar
        .col-lg-4.col-sm-12.pr-30.mb-50
          h2.text-heading-3.color-gray-900.mb-30.border-bottom.border-3.pb-5.border-primary-subtle Featured Ministry Stories
          each item in nbcData.featuredNews.sort((a, b) => new Date(b.date) - new Date(a.date))
            .card-list-style-1
              a.text-heading-6(href='/news/sample-article/')= item.title
              p.text-body-small.color-gray-500.mb-40= new Date(item.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
              .style-1-img.color-bg-8
                a(href='/news/sample-article/')
                  img(src='../../assets/imgs/page/blog/2/img-news-1.png', alt='Agon')

          h2.text-heading-3.color-gray-900.mt-100.mb-30.border-bottom.border-3.border-danger-subtle.pb-5 Campus & Online Program Announcements
          each item in nbcData.featuredNews.sort((a, b) => new Date(b.date) - new Date(a.date))
            .card-list-style-1
              a.text-heading-6(href='/news/sample-article/')= item.title
              p.text-body-small.color-gray-500.mb-40= new Date(item.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
              .style-1-img.color-bg-3
                a(href='/news/sample-article/')
                  img(src='../../assets/imgs/page/blog/2/img-news-1.png', alt='Agon')

          h2.text-heading-3.color-gray-900.mt-100.mb-30.border-bottom.border-3.border-info-subtle.pb-5 Reflections & Devotionals
          each item in nbcData.featuredNews.sort((a, b) => new Date(b.date) - new Date(a.date))
            .card-list-style-1
              a.text-heading-6(href='/news/sample-article/')= item.title
              p.text-body-small.color-gray-500.mb-40= new Date(item.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
              .style-1-img.color-bg-6
                a(href='/news/sample-article/')
                  img(src='../../assets/imgs/page/blog/2/img-news-1.png', alt='Agon')

  include ../../sections/section_newsletter_2.pug